<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>高考志愿填报分析</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-indigo-50">
    <%- include('nav', { active: 'index' }) %>

    <main class="max-w-7xl mx-auto px-4 py-6 md:py-8">
        <div class="max-w-2xl mx-auto">
            <div class="text-center mb-6 md:mb-8">
                <h1 class="text-2xl md:text-3xl font-bold text-gray-800 mb-2">智能志愿填报分析</h1>
                <p class="text-sm md:text-base text-gray-500">输入你的高考成绩，AI 帮你分析最优志愿方案</p>
            </div>

            <% if (error) { %>
            <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6 text-sm"><%= error %></div>
            <% } %>

            <div class="bg-white rounded-2xl shadow-lg p-5 md:p-8">
                <form method="POST" action="/analyze" id="analyzeForm">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6 mb-4 md:mb-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">高考分数</label>
                            <input type="number" name="score" required min="100" max="750" placeholder="如：580"
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-base">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">科类</label>
                            <select name="subject" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-base">
                                <option value="理科">理科 / 物理类</option>
                                <option value="文科">文科 / 历史类</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6 mb-4 md:mb-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">所在省份</label>
                            <select name="province" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-base">
                                <option value="">请选择省份</option>
                                <% provinces.forEach(p => { %>
                                <option value="<%= p %>"><%= p %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">办学层次</label>
                            <select name="level" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-base">
                                <option value="本科">本科</option>
                                <option value="高职（专科）">专科</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4 md:mb-6">
                        <label class="block text-sm font-medium text-gray-700 mb-3">意向行业</label>
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2 md:gap-3" id="industryGrid">
                            <label class="industry-option cursor-pointer">
                                <input type="radio" name="industry" value="" class="hidden peer" checked>
                                <div class="peer-checked:bg-blue-600 peer-checked:text-white peer-checked:border-blue-600 border border-gray-300 rounded-lg px-3 py-2 text-center text-sm hover:border-blue-400 transition">
                                    <div class="text-lg mb-0.5">🎯</div>
                                    <div class="text-xs">不限</div>
                                </div>
                            </label>
                            <% industries.forEach(ind => { %>
                            <label class="industry-option cursor-pointer">
                                <input type="radio" name="industry" value="<%= ind.id %>" class="hidden peer">
                                <div class="peer-checked:bg-blue-600 peer-checked:text-white peer-checked:border-blue-600 border border-gray-300 rounded-lg px-3 py-2 text-center text-sm hover:border-blue-400 transition">
                                    <div class="text-lg mb-0.5"><%= ind.icon %></div>
                                    <div class="text-xs"><%= ind.name.split('/')[0] %></div>
                                </div>
                            </label>
                            <% }); %>
                        </div>
                    </div>

                    <div class="mb-6 md:mb-8">
                        <label class="block text-sm font-medium text-gray-700 mb-2">其他偏好（可选）</label>
                        <input type="text" name="preference" placeholder="如：北京/上海、985、离家近..."
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    </div>

                    <button type="submit" id="submitBtn"
                        class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white py-3 md:py-4 rounded-lg text-base md:text-lg font-semibold hover:from-blue-700 hover:to-indigo-700 transition-all shadow-lg active:scale-[0.98]">
                        开始 AI 分析
                    </button>
                </form>
            </div>

            <div class="mt-6 md:mt-8 grid grid-cols-3 gap-3 md:gap-4 text-center">
                <div class="bg-white rounded-xl p-3 md:p-4 shadow-sm">
                    <div class="text-xl md:text-2xl mb-1">📊</div>
                    <div class="text-xs md:text-sm font-medium text-gray-700">2900+ 高校</div>
                </div>
                <div class="bg-white rounded-xl p-3 md:p-4 shadow-sm">
                    <div class="text-xl md:text-2xl mb-1">🤖</div>
                    <div class="text-xs md:text-sm font-medium text-gray-700">AI 分析</div>
                </div>
                <div class="bg-white rounded-xl p-3 md:p-4 shadow-sm">
                    <div class="text-xl md:text-2xl mb-1">🏭</div>
                    <div class="text-xs md:text-sm font-medium text-gray-700">行业筛选</div>
                </div>
            </div>
        </div>
    </main>

    <footer class="text-center py-4 md:py-6 text-gray-400 text-xs md:text-sm">
        数据来源：阳光高考网 · AI 分析仅供参考
    </footer>

    <script>
    document.getElementById('analyzeForm').addEventListener('submit', function() {
        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.textContent = 'AI 分析中，请稍候...';
        btn.classList.add('opacity-70', 'cursor-not-allowed');
    });
    </script>
</body>
</html>
